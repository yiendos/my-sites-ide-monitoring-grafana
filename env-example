# [grafana]
# Defaults live in this plugin's .env. GRAFANA_PORT is the host port for the web UI
# (http://localhost:3000). Grafana lets you straight in as Admin unless GRAFANA_ANONYMOUS=false,
# which brings back the login form - admin / GRAFANA_ADMIN_PASSWORD, which only takes effect
# when Grafana first creates its database (change it later with monitoring:grafana-password).
# Run `php my-sites-ide monitoring:grafana-start` after changing any of them.
#GRAFANA_PORT=3000
#GRAFANA_ANONYMOUS=true
#GRAFANA_ADMIN_PASSWORD=admin
